{
	"name": "cypress-ai-tests",
	"version": "1.0.0",
	"description": "Cypress E2E tests with TypeScript for AI-powered testing",
	"main": "index.js",
	"scripts": {
		"cy:open": "cypress open",
		"cy:run": "cypress run",
		"cy:run:headed": "cypress run --headed",
		"cy:run:chrome": "cypress run --browser chrome",
		"cy:run:firefox": "cypress run --browser firefox",
		"cy:run:edge": "cypress run --browser edge",
		"cy:run:chrome:headed": "cypress run --browser chrome --headed",
		"cy:run:firefox:headed": "cypress run --browser firefox --headed",
		"cy:run:edge:headed": "cypress run --browser edge --headed",
		"cy:run:record": "cypress run --record",
		"cy:run:parallel": "cypress run --parallel",
		"cy:run:ci": "cypress run --browser chrome --headless",
		"cy:run:smoke": "cypress run --spec 'cypress/e2e/signin.cy.ts'",
		"cy:run:signin": "cypress run --spec 'cypress/e2e/signin.cy.ts'",
		"cy:run:signup": "cypress run --spec 'cypress/e2e/signup.cy.ts'",
		"cy:run:debug": "cypress run --headed --no-exit",
		"cy:run:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
		"cy:run:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024",
		"cy:run:desktop": "cypress run --config viewportWidth=1920,viewportHeight=1080",
		"cy:run:report": "cypress run --reporter json --reporter-options output=cypress/reports/results.json",
		"cy:run:video": "cypress run --config video=true",
		"cy:run:no-video": "cypress run --config video=false",
		"cy:run:env:dev": "cypress run --env environment=development",
		"cy:run:env:staging": "cypress run --env environment=staging",
		"cy:run:env:prod": "cypress run --env environment=production",
		"test": "npm run cy:run",
		"test:open": "npm run cy:open",
		"test:headed": "npm run cy:run:headed",
		"test:chrome": "npm run cy:run:chrome",
		"test:firefox": "npm run cy:run:firefox",
		"test:edge": "npm run cy:run:edge",
		"test:smoke": "npm run cy:run:smoke",
		"test:debug": "npm run cy:run:debug",
		"test:mobile": "npm run cy:run:mobile",
		"test:tablet": "npm run cy:run:tablet",
		"test:desktop": "npm run cy:run:desktop",
		"test:ci": "npm run cy:run:ci",
		"test:record": "npm run cy:run:record",
		"test:parallel": "npm run cy:run:parallel",
		"test:report": "npm run cy:run:report",
		"test:video": "npm run cy:run:video",
		"test:no-video": "npm run cy:run:no-video",
		"test:env:dev": "npm run cy:run:env:dev",
		"test:env:staging": "npm run cy:run:env:staging",
		"test:env:prod": "npm run cy:run:env:prod",
		"lint": "eslint cypress/**/*.ts",
		"lint:fix": "eslint cypress/**/*.ts --fix",
		"lint:cypress": "eslint cypress/e2e/**/*.cy.ts",
		"lint:cypress:fix": "eslint cypress/e2e/**/*.cy.ts --fix",
		"lint:support": "eslint cypress/support/**/*.ts",
		"lint:support:fix": "eslint cypress/support/**/*.ts --fix",
		"format": "prettier --write cypress/**/*.{ts,json}",
		"format:check": "prettier --check cypress/**/*.{ts,json}",
		"format:cypress": "prettier --write cypress/e2e/**/*.cy.ts",
		"format:support": "prettier --write cypress/support/**/*.ts",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf cypress/videos cypress/screenshots cypress/reports",
		"clean:all": "rm -rf node_modules cypress/videos cypress/screenshots cypress/reports",
		"setup": "npm install && npm run type-check",
		"precommit": "npm run lint && npm run format:check && npm run type-check",
		"postinstall": "echo '🎉 Cypress AI Tests setup complete! Run npm run test:open to start testing'"
	},
	"keywords": [
		"cypress",
		"e2e",
		"testing",
		"typescript",
		"automation",
		"ai",
		"quality-assurance"
	],
	"author": "QA Automation Team",
	"license": "MIT",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"cypress": "^15.1.0",
		"eslint": "^8.0.0",
		"eslint-plugin-cypress": "^2.15.0",
		"prettier": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"engines": {
		"node": ">=16.0.0",
		"npm": ">=8.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/your-org/cypress-ai-tests.git"
	},
	"bugs": {
		"url": "https://github.com/your-org/cypress-ai-tests/issues"
	},
	"homepage": "https://github.com/your-org/cypress-ai-tests#readme"
}
